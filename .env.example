# --- Required ---------------------------------------------------------------
# Neon PostgreSQL connection string (Neon dashboard → Connection details).
# Any standard PostgreSQL URL also works for local development.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# One-time code required to create the single user account on first visit.
# Required in production so nobody else can claim your deployment.
SETUP_CODE="choose-a-one-time-setup-code"

# --- Optional: AI assistant (Vercel AI Gateway) -----------------------------
# On Vercel, the AI Gateway can authenticate via OIDC automatically; otherwise
# create a key at https://vercel.com/ai-gateway and set it here.
AI_GATEWAY_API_KEY=""
# Gateway model id used by the assistant.
AI_MODEL="anthropic/claude-sonnet-5.5"
